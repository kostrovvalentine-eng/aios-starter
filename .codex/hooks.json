{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/aios-doctor.mjs --quiet --no-write",
            "statusMessage": "Checking AIOS routing and freshness"
          }
        ]
      }
    ]
  }
}
